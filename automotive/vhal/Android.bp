package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.automotive.vehicle@schuurman-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.automotive.vehicle@schuurman-service.rc"],
    vintf_fragments: ["android.hardware.automotive.vehicle@schuurman-service.xml"],

    defaults: [
        "VehicleHalDefaults",
    ],

    required: [
        "init.vehicle.sh",
    ],

    srcs: [
        "Main.cpp",
        "SchuurmanVehicleHardware.cpp",
    ],

    local_include_dirs: ["."],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "android.hardware.automotive.vehicle-V4-ndk",
    ],

    static_libs: [
        "DefaultVehicleHal",
        "VehicleHalUtils",
    ],
    
    header_libs: [
        "IVehicleHardware",
    ],
    
    cflags: [
        "-DLOG_TAG=\"SchuurmanVehicleHal\"",
    ]
}

cc_binary {
    name: "bh1750d",
    vendor: true,
    srcs: [
        "bh1750d.cpp",
        "bh1750_i2c.cpp",
        "bh1750_main.cpp",
    ],
    shared_libs: [
        "liblog",
        "libbase",
        "libandroid",
        "libutils",
    ],
    cflags: ["-Wall", "-Wextra", "-fno-exceptions"],
    init_rc: ["init.bh1750d.rc"],
}

sh_binary {
    name: "init.vehicle.sh",
    src: "init.vehicle.sh",
    vendor: true,
}