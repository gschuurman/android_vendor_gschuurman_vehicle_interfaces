package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.automotive.vehicle@schuurman-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.automotive.vehicle@schuurman-service.rc"],
    vintf_fragments: ["android.hardware.automotive.vehicle@schuurman-service.xml"],

    defaults: [
        "VehicleHalDefaults",
    ],

    srcs: [
        "Main.cpp",
        "McuLink.cpp",
        "SchuurmanVehicleHardware.cpp",
    ],

    local_include_dirs: ["."],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "android.hardware.automotive.vehicle-V4-ndk",
    ],

    static_libs: [
        "DefaultVehicleHal",
        "VehicleHalUtils",
    ],
    
    header_libs: [
        "IVehicleHardware",
        "gschuurman_mcu_protocol_headers",
    ],
    
    cflags: [
        "-DLOG_TAG=\"SchuurmanVehicleHal\"",
    ]
}

// Debug tool for the peripheral board MCU (adb root shell): mcutool status | watch | set | bootsel
cc_binary {
    name: "mcutool",
    vendor: true,
    srcs: [
        "mcutool.cpp",
        "McuLink.cpp",
    ],
    local_include_dirs: ["."],
    header_libs: ["gschuurman_mcu_protocol_headers"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

// Not needed with the rev 0.6 peripheral board: the BH1750 sits on the MCU's I2C bus and
// reaches the VHAL as MCU_PROP_LUX.
cc_binary {
    name: "bh1750d",
    vendor: true,
    srcs: [
        "bh1750d.cpp",
        "bh1750_i2c.cpp",
        "bh1750_main.cpp",
    ],
    shared_libs: [
        "liblog",
        "libbase",
        "libandroid",
        "libutils",
    ],
    cflags: ["-Wall", "-Wextra", "-fno-exceptions"],
    init_rc: ["init.bh1750d.rc"],
}

// Backlight PWM and reverse GPIO on the VIM3 header: only for the old perfboard setup. With the
// rev 0.6 peripheral board the MCU drives both, and header pins 32/33/35 carry audio.
sh_binary {
    name: "init.vehicle.sh",
    src: "init.vehicle.sh",
    vendor: true,
}