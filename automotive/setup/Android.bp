// First-boot setup for the VIM3 head unit: Wi-Fi, Google account, then marks the device provisioned.
// Replaces the Google car setup wizard (not usable on this hardware) and AOSP's silent CarProvision
// flow as the HOME activity while the device is unprovisioned.
android_app {
    name: "Vim3Setup",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    required: [
        "privapp-permissions-vim3setup",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-vim3setup",
    src: "privapp-permissions-vim3setup.xml",
    sub_dir: "permissions",
    // Must live on the same partition as the priv-app it allowlists (Vim3Setup is in /system/priv-app);
    // a /product copy is ignored and system_server aborts with "not in privileged permission allowlist".
    filename_from_src: true,
}
