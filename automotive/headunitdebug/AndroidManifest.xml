<?xml version="1.0" encoding="utf-8"?>
<!-- Head unit debug screen: peripheral board MCU values from the VHAL and the GNSS receiver. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gschuurman.headunitdebug">

    <!-- MCU_PROP_* vendor properties (mcu/protocol/mcu_protocol.h) -->
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <!-- GEAR_SELECTION, IGNITION_STATE, PARKING_BRAKE_ON -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- NIGHT_MODE -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <!-- PERF_VEHICLE_SPEED (runtime) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- GPS fix and satellites (runtime) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.HeadUnitDebug">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
