package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Equalizer and balance/fader settings, injected into the CarSettings "Sound" page.
android_app {
    name: "CarAudioTuner",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    platform_apis: true,
    certificate: "platform",

    // car-ui-lib calls into the car framework (UX restrictions).
    libs: [
        "android.car",
    ],

    // Uses the car UI library, like CarSettings.
    static_libs: [
        "androidx.fragment_fragment",
        "androidx.preference_preference",
        "car-ui-lib",
    ],
}
