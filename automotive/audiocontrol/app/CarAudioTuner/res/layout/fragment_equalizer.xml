<?xml version="1.0" encoding="utf-8"?>
<!-- Graphic equalizer: on/off, preset and reset on top, the response curve, then the preamp and
     band sliders (added by EqualizerFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/eq_enabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/eq_enabled_title"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:switchPadding="16dp"
            android:layout_gravity="start" />

        <Button
            android:id="@+id/eq_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/eq_preset_title" />

        <Button
            android:id="@+id/eq_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/eq_reset_title" />
    </LinearLayout>

    <com.gschuurman.caraudiotuner.EqCurveView
        android:id="@+id/eq_curve"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/eq_sliders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />
</LinearLayout>
