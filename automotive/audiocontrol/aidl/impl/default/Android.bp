cc_binary {
    name: "android.hardware.automotive.audiocontrol-service",
    vendor: true,
    relative_install_path: "hw",

    srcs: [
        "Main.cpp",
        "GschuurmanAudioControl.cpp",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "android.hardware.automotive.audiocontrol-V1-ndk",
        "android.hardware.audio.core-V1-ndk",
    ],

    init_rc: ["android.hardware.automotive.audiocontrol-service.rc"],
    vintf_fragments: ["android.hardware.automotive.audiocontrol-service.xml"],
}
