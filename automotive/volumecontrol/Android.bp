android_app {
    name: "VolumeControl",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    libs: [
        "android.car-system-stubs",
    ],
    required: ["allowed_privapp_com.schuurman.vim3.volumecontrol"],
}

prebuilt_etc {
    name: "allowed_privapp_com.schuurman.vim3.volumecontrol",
    sub_dir: "permissions",
    src: "permissions/com.schuurman.vim3.volumecontrol.xml",
    filename_from_src: true,
}
