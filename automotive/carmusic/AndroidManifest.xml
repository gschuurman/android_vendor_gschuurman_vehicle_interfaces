<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gschuurman.carmusic">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Cover images (cover.jpg, folder.png) on USB storage. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Album covers from MusicBrainz / Cover Art Archive (CoverFetchJob). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_music"
        android:theme="@style/Theme.CarMusic">

        <!-- The car media source. -->
        <service
            android:name=".MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- The app also has a launcher activity (import); without this opt-in the car Media
                 app treats it as a non-template app and skips this source for Now Playing. -->
            <meta-data android:name="androidx.car.app.launchable" android:value="true" />
        </service>

        <!-- Copies music from USB storage into the Music folder. -->
        <service
            android:name=".ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Fetches missing album covers from MusicBrainz / Cover Art Archive. -->
        <service
            android:name=".CoverFetchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Album art for the Media app (which can't read this app's MediaStore grants). -->
        <provider
            android:name=".ArtProvider"
            android:authorities="com.gschuurman.carmusic.art"
            android:exported="true" />

        <!-- "Import music" in the app grid, and the target of the USB notification. -->
        <activity
            android:name=".ImportActivity"
            android:exported="true"
            android:label="@string/import_title"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- Offers an import when USB storage with music is mounted. -->
        <receiver
            android:name=".UsbMountReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
