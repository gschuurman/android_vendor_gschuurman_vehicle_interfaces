service vendor.vehicle-snap /vendor/bin/hw/android.hardware.automotive.vehicle@snap-service
    class early_hal
    user vehicle_network
    group system inet
    
    # Zorg dat bij restart de permissies voor je hardware goed staan
    on restart
        # Pas deze paden aan naar de werkelijke paden op de VIM3
        chmod 0666 /sys/class/pwm/pwmchip0/pwm0/duty_cycle
        chmod 0666 /sys/class/pwm/pwmchip0/pwm0/enable