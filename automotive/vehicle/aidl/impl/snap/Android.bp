package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.automotive.vehicle@snap-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.automotive.vehicle@snap-service.rc"],
    vintf_fragments: ["android.hardware.automotive.vehicle@snap-service.xml"],

    defaults: [
        "VehicleHalDefaults",
    ],

    srcs: [
        "Main.cpp",
        "SnapVehicleHardware.cpp",
    ],

    local_include_dirs: ["."],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "android.hardware.automotive.vehicle-V4-ndk",
    ],

    static_libs: [
        "DefaultVehicleHal",
        "VehicleHalUtils",
    ],
    
    header_libs: [
        "IVehicleHardware",
    ],
    
    cflags: [
        "-DLOG_TAG=\"SnapVehicleHal\"",
    ]
}