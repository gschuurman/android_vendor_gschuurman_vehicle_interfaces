package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.gnss-service.usb",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["init/android.hardware.gnss-service.usb.rc"],
    vintf_fragments: ["vintf/android.hardware.gnss-service.usb.xml"],
    srcs: [
        "src/main.cpp",
        "src/GnssUsb.cpp",
        "src/SerialGpsProbe.cpp",
        "src/NmeaParser.cpp",
        "src/GnssStubs.cpp",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "android.hardware.gnss-V4-ndk",
    ],
}

prebuilt_etc {
    name: "android.hardware.gnss-service.usb.rc",
    vendor: true,
    src: "init/android.hardware.gnss-service.usb.rc",
    filename_from_src: true,
}
