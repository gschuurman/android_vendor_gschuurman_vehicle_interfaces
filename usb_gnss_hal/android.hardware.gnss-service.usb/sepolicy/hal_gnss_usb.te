# Minimal policy for bring-up. You will likely need to adapt types/names in your tree.

type hal_gnss_usb, domain, haldomain;
type hal_gnss_usb_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_gnss_usb)

# Allow talking to the (vendor) service manager
vndbinder_use(hal_gnss_usb)

# Allow reading USB serial devices (type may differ on your tree)
allow hal_gnss_usb tty_device:chr_file { open read getattr ioctl };
allow hal_gnss_usb serial_device:chr_file { open read getattr ioctl };
allow hal_gnss_usb usb_device:chr_file { open read getattr ioctl };

# Allow access to /dev nodes discovered during scanning
allow hal_gnss_usb device:dir { open read search getattr };
