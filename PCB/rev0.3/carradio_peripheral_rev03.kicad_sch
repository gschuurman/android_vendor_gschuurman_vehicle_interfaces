    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "e62df04d-b562-567a-b756-8f24c21d7d22"))
  (text
    "Backlight EN/PWM now go straight to the panel: 0V = brightest, 3.3V = darkest (invert PWM in firmware). J6 removed."
    (at 12 556 0)
