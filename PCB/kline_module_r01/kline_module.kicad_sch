(instances (project "kline_module" (path "/7a5a632b-50ad-4c1f-a2a1-c27fa1584c0f" (reference "H1") (unit 1)))))
(text "K-line module rev 0.1 for the car radio main board rev 0.6 (plugs into J10, held by an M2 screw + 11 mm spacer at H8)" (at 20.32 25.4 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid 185cf7bd-d1ae-4b0f-91cf-11cc4f04fd16))
(text "Car side: J2 pin 1 = K-line (OBD-II socket pin 7, ECU pin per the MG F wiring diagram), pin 2 = GND (OBD-II pin 4/5). Battery comes from J10 pin 7 (F6 on the main board)." (at 20.32 33.02 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 001f2302-bb44-4ad5-8462-ce910a0af56a))
(text "U1 L9637D runs VCC from +3V3 (datasheet range 3-7 V), so RX swings 0-3.3 V straight into GPIO33 and TX takes 3.3 V logic (VIH max 2.5 V). RX/TX/LO have internal pull-ups to VCC." (at 20.32 36.620000000000005 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 4e75aee5-dd53-4e6b-9be1-ba2e359d43e4))
(text "Q1 switches battery to VS and to the 510R ISO 9141 pull-up. GPIO28 low (default, R4) = Q1 off: no parked drain and no 12 V pushed into the ECU K-line with ignition off." (at 20.32 40.220000000000006 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 5e162fb1-c906-4ec6-826f-6201bbc9c979))
(text "D1 limits Q1 Vgs to 12 V up to the 35.5 V clamp of the main-board TVS. JP1 is bridged: cut it if the ECU already pulls K up and you want the tester-side pull-up gone." (at 20.32 43.82000000000001 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 623d4aa2-1a56-425e-b757-40fdc5d542f6))
(text "Firmware: GPIO28 high, wait ~10 ms. MEMS 1.9: ISO 9141 5-baud init of address 0x16 bit-banged on GPIO32, then UART0 9600 8N1 (per rovermems.com). L-line not used (LI/LO open, defined by U1)." (at 20.32 47.42 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid bb0cef2c-4b27-4dd6-a2a6-a87430210589))
(text "J10 on the main board" (at 30.48 55.88 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid 20d5830e-6c5a-497f-b5e1-be530a025d81))
(text "to the car (JST XH side entry)" (at 160.02 55.88 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid 1fce47d8-a77f-4611-8a27-eef2df858fbf))
(text "K-line protection and pull-up" (at 140.97 78.74 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid d823e4d0-00cd-450d-8185-b02de9214ac4))
(text "K-line power switch (GPIO28) and power LED" (at 45.72 106.68 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid 7613efcf-7f10-4b9e-9698-2718cfe16e83))
