package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Wire protocol shared by the RP2350B firmware (firmware/), the VHAL and the
// AudioControl service (system_ext, writes MCU_PROP_AUDIO_MUTE through the VHAL).
cc_library_headers {
    name: "gschuurman_mcu_protocol_headers",
    vendor_available: true,
    export_include_dirs: ["protocol"],
}
